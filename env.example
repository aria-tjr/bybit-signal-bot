# Crypto Signal Bot Environment Variables
# Copy this file to .env and fill in your values

# Bybit API Configuration
# Get your API keys from https://www.bybit.com/app/user/api-management
# IMPORTANT: Use read-only permissions for security
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=false  # Set to true for testnet

# Telegram Bot Configuration
# Create a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Add authorized chat IDs (comma separated)
TELEGRAM_CHAT_IDS=["123456789", "987654321"]

# Trading Configuration
DEFAULT_THRESHOLD_PCT=20.0  # Default profit target percentage
MAX_LEVERAGE=50  # Maximum allowed leverage
MIN_LEVERAGE=10  # Minimum leverage

# Time Frames to Analyze
TIME_FRAMES=["1m", "5m", "15m", "1h", "4h"]

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_TTL=3600  # Cache TTL in seconds

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@timescaledb:5432/crypto_signals

# Performance Settings
MAX_CONCURRENT_JOBS=50
LATENCY_THRESHOLD_MS=2000

# Monitoring
PROMETHEUS_PORT=8001

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json or text

# ML Model
MODEL_PATH=./models/confidence_model.pkl
MODEL_RETRAIN_DAYS=90

# WebSocket Settings
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
WS_RECONNECT_ATTEMPTS=5

# Application
APP_NAME="Crypto Signal Bot"
APP_VERSION=1.0.0
DEBUG=false 